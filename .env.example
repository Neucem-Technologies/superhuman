# LivinSync — connector keys (empty = mock feed, which is what the preview uses).
# Live secrets file: `secrets/.env` (gitignored). Copy this list there to paste keys.
# Never commit `secrets/.env` or a root `.env`.
# All of these are server-side. Do not prefix them with VITE_ (that would leak
# secrets to the browser).
#
# Platform-injected (leave commented unless you run outside this workspace):
# DATABASE_URL=
# XAI_API_KEY=
# VITE_AUTH_ENABLED=true

# --- Google (Gmail, Calendar, Contacts) → Work ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Google Tasks → Work ---
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET. Enable Tasks API.

# --- Slack → Work ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# --- Microsoft Graph (Outlook, To Do, OneDrive) → Work · Files ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# --- WhatsApp Cloud API → Work · Notes ---
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Apple Health → Health ---
# No web API key. HealthKit runs on an iPhone companion / export.
# APPLE_TEAM_ID=
# APPLE_HEALTHKIT_ENABLED=false

# --- UltraHuman ring → Health ---
ULTRAHUMAN_API_KEY=
ULTRAHUMAN_CLIENT_ID=
ULTRAHUMAN_CLIENT_SECRET=

# --- Fitbit → Health ---
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=

# --- MakeMyTrip → Travel ---
MMT_AFFILIATE_ID=
MMT_AUTH_TOKEN=

# --- Airbnb → Travel ---
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=
AIRBNB_ICAL_URL=

# --- Bank / UPI (Account Aggregator + PSP) → Finance ---
AA_CLIENT_ID=
AA_CLIENT_SECRET=
UPI_KEY_ID=
UPI_KEY_SECRET=

# --- GST / invoices → Businesses ---
GSTIN=
GSP_USERNAME=
GSP_APP_KEY=
GSP_APP_SECRET=
BOOKS_API_KEY=

# --- YouTube → Growth · Enjoy ---
# OAuth can reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Spotify → Growth · Enjoy ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# --- Amazon (PA-API prices; SP-API only if you sell) → Shopping ---
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=

# --- BigBasket → Shopping ---
BIGBASKET_PARTNER_TOKEN=
BIGBASKET_ACCOUNT_EMAIL=

# --- Google Drive → Files ---
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
GOOGLE_DRIVE_SCOPE=drive.readonly

# --- Dropbox → Files ---
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=

# --- Notion → Notes ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
